# Copy this file to .env.local and fill in real values from your Supabase
# project (Settings -> Data API for the URL, Settings -> API Keys for the
# anon key).

NEXT_PUBLIC_SUPABASE_URL=

# base64-encode the raw anon key before pasting it here — see
# src/lib/supabase/anon-key.ts for why. Generate with:
# node -e "console.log(Buffer.from('<raw key>').toString('base64'))"
NEXT_PUBLIC_SUPABASE_ANON_KEY_B64=
